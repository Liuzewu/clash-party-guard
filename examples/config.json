{
  "controller": "http://127.0.0.1:9090",
  "secret_env": "CLASH_CONTROLLER_SECRET",
  "group": "Example Selector",
  "targets": [
    {"url": "https://example.com/", "expected": "200"},
    {"url": "https://example.org/", "expected": "200"}
  ],
  "health_url": "https://www.gstatic.com/generate_204",
